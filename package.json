{
  "name": "axivale",
  "version": "1.0.0",
  "description": "AxiVale — a virtual officer for GW2 guild + Discord management",
  "author": "darkharasho",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.viewer.config.ts",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "start": "electron-vite preview",
    "test": "vitest run",
    "eval": "EVAL_LIVE=1 vitest run src/main/meta/*.eval.test.ts",
    "eval:record": "EVAL_RECORD=1 vitest run src/main/meta/*.eval.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/gen-class-icons.cjs",
    "icons:svg": "node scripts/gen-class-icons-svg.cjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.174",
    "@axiapps/bridge-metrics": "^0.1.0",
    "@axiapps/forge-render": "^0.1.7",
    "@axiapps/gw2-data": "^0.1.3",
    "@lancedb/lancedb": "^0.30.0",
    "@openai/codex": "^0.140.0",
    "@xenova/transformers": "^2.17.2",
    "apache-arrow": "18.1.0",
    "electron-updater": "^6.8.9",
    "jq-web": "^0.6.2",
    "modern-screenshot": "^4.7.0",
    "recharts": "^3.8.1",
    "remark-breaks": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/hast": "^3.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "emoji-regex": "^10.6.0",
    "gw2-class-icons": "^0.3.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.17.0",
    "playwright-core": "^1.60.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.6.0",
    "unicode-emoji-json": "^0.9.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.darkharasho.axivale",
    "productName": "AxiVale",
    "publish": [
      {
        "provider": "github",
        "owner": "darkharasho",
        "repo": "axivale",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/claude-agent-sdk*/**",
      "**/node_modules/@openai/codex*/**",
      "**/codexOfficerServer.js",
      "**/node_modules/@lancedb/**",
      "**/node_modules/@xenova/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/onnxruntime-web/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    }
  }
}
