{
  "name": "axivale",
  "version": "0.1.0",
  "description": "AxiVale — a virtual officer for GW2 guild + Discord management",
  "author": "darkharasho",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/gen-class-icons.cjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.174",
    "electron-updater": "^6.8.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "emoji-regex": "^10.6.0",
    "gw2-class-icons": "file:../gw2-class-icons",
    "lucide-react": "^1.17.0",
    "playwright-core": "^1.60.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.6.0",
    "unicode-emoji-json": "^0.9.0",
    "unist-util-visit": "^5.1.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.darkharasho.axivale",
    "productName": "AxiVale",
    "publish": [
      {
        "provider": "github",
        "owner": "darkharasho",
        "repo": "axivale"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    }
  }
}
